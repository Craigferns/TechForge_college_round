# AgentBreak Environment Configuration Template
# Copy to .env: cp .env.example .env (or Copy-Item .env.example .env in PowerShell)

# SQLite Storage
AGENTBREAK_DB_PATH=./data/agentbreak.db

# API Server (Keep local; no auth in MVP)
AGENTBREAK_HOST=127.0.0.1
AGENTBREAK_PORT=8000
AGENTBREAK_CORS_ORIGINS=http://localhost:5173

# Engine Execution
AGENTBREAK_RUN_TIMEOUT_S=120
AGENTBREAK_MAX_WORKERS=2
AGENTBREAK_ALLOW_REMOTE_TARGETS=0

# Ollama / Local LLMs (Optional for real-LLM runs)
OLLAMA_BASE_URL=http://localhost:11434/v1
TARGET_MODEL=
ATTACKER_MODEL=

# Frontend Data Mode (live | mock)
VITE_API_MODE=live
VITE_API_BASE=/api/v1
